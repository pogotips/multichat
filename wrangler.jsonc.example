// Copy this file to `wrangler.jsonc` and fill in your own values.
// The real `wrangler.jsonc` is gitignored so your channel/domain never lands
// in a public fork's history. See README / docs/ARCHITECTURE.md for setup.
{
	"name": "multichat",
	"main": "src/worker.js",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			// custom_domain:true means `pattern` is a bare hostname only — no
			// wildcard (*), no path — replace chathub.example.com with yours.
			"pattern": "chathub.example.com",
			"custom_domain": true
		}
	],
	"compatibility_date": "2026-07-20",
	"vars": {
		"TWITCH_CHANNEL": "YOUR_CHANNEL",
		// Numeric broadcaster user id for YOUR_CHANNEL — resolved once via a
		// public login->id lookup (no Twitch auth needed, id is not sensitive).
		// Never changes for a given channel; Get Channel Followers requires it.
		"TWITCH_BROADCASTER_ID": "YOUR_BROADCASTER_ID",
		// Chat display-name for self-mention highlighting. Independent of
		// TWITCH_CHANNEL (that's the login, this is the display name used in
		// chat). Leave blank to disable highlighting.
		"MULTICHAT_MY_NAME": "",
		// Optional. Extra words the phone TTS speaks as "bleep", comma-separated
		// (whole-word in chat text, substring in usernames — keep them unambiguous).
		// Empty = built-in list only.
		"MULTICHAT_TTS_EXTRA_CURSES": "",
		// Optional kill switch for the superseded-DO detector (a Durable Object
		// instance that stops receiving alarms while SSE clients are attached
		// closes its own SSE streams + IRC socket so clients reconnect to the
		// live instance). Default on; set to "off" to disable the detector.
		"MULTICHAT_SUPERSEDED_DETECT": "on"
		// MULTICHAT_TTS_REWARD_ID is a wrangler SECRET, not a var: never add it
		// here (a vars entry of the same name would shadow the secret).
		// MULTICHAT_TTS_SAY_AS is also a wrangler SECRET, never a var: a JSON
		// object of word -> spoken form (e.g. {"Word":"how it is said"}), applied
		// to speech only. Set it with `wrangler secret put MULTICHAT_TTS_SAY_AS`.
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "HUB",
				"class_name": "ChatHub"
			}
		]
	},
	"r2_buckets": [
		{
			"binding": "CAPTURE",
			"bucket_name": "multichat-capture"
		}
	],
	"ai": { "binding": "AI" },
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"ChatHub"
			]
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}
